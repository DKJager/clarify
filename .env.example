FINDER_MODEL=us.amazon.nova-2-lite-v1:0
GROUNDING_MODEL=us.amazon.nova-2-lite-v1:0
JUDGE_MODELS=us.amazon.nova-2-lite-v1:0,mistral.mistral-large-3-675b-instruct,openai.gpt-oss-120b-1:0
PORT=3000
